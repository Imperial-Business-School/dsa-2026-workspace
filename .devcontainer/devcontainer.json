{
  "name": "DSA Codespaces Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/.devcontainer": true,
          "**/.gitignore": true
        },
        "explorer.autoOpenDroppedFile": false,
        "livePreview.openPreviewTarget": "embeddedPreview",
        "livePreview.showAutoRefreshOnUpdate": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-vscode.live-server",
        "nmhp.compress-to-zip",
        "repreng.csv",
        "tomoki1207.pdf",
        "github.vscode-pull-request-github"
      ]
    }
  },
  "postCreateCommand": "python3 -m pip install --upgrade pip && python3 -m pip install numpy pandas matplotlib networkx xlrd ipykernel beautifulsoup4 requests && python3 -m ipykernel install --user --name python3 --display-name \"Python 3\""
}
