{
  "name": "DSA Codespaces Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/.devcontainer": true,
          "**/.gitignore": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "george-alisson.html-preview-vscode",
        "repreng.csv",
        "tomoki1207.pdf",
        "github.vscode-pull-request-github"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install numpy pandas matplotlib networkx xlrd ipykernel beautifulsoup4 requests && python -m ipykernel install --user --name python3 --display-name \"Python 3\""
}
